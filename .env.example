# Скопируйте этот файл в .env (cp .env.example .env / copy .env.example .env)
# SauceDemo — публичный учебный сайт, эти данные можно хранить в учебном проекте.
# В реальном проекте .env с настоящими паролями НИКОГДА не коммитим и не отправляем в AI.
BASE_URL=https://www.saucedemo.com/
SAUCE_USER=standard_user
SAUCE_PASSWORD=secret_sauce
HEADLESS=false
WAIT_TIMEOUT=10
